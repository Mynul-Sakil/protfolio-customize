# MongoDB Connection String (Required)
# How to get: 
# 1. Create a free account at https://www.mongodb.com/cloud/atlas
# 2. Create a new cluster and click "Connect".
# 3. Choose "Connect your application" and copy the connection string. Replace <password> with your database user password.
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/mydatabase?retryWrites=true&w=majority"

# NextAuth Configuration (Required)
# NEXTAUTH_URL should be the base URL of your application (e.g., http://localhost:3000 for local development)
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET is used to encrypt JWT tokens.
# How to get: Run `openssl rand -base64 32` in your terminal, or use any long, random, secure string.
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Cloudinary Configuration (Required for Profile Image Uploads)
# How to get:
# 1. Create a free account at https://cloudinary.com/
# 2. Go to your Dashboard and look for your "Cloud Name".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
